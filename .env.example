# Supabase — required for Community submissions.
# Copy this file to `.env.local` and fill in real values (never commit them).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: server-side only. Prefer the anon key + RLS (schema below allows
# anonymous inserts). Only set a service-role key here if you intentionally
# want elevated server access — NEVER prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
